{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "packages": {
    "check-label": {
      "component": "check-label",
      "paths": [
        "check-label"
      ]
    },
    "crs-plugin-lint": {
      "component": "crs-plugin-lint",
      "paths": [
        "crs-plugin-lint",
        ".github/workflows/crs-plugin-lint.yaml"
      ]
    },
    "crs-plugin-test": {
      "component": "crs-plugin-test",
      "paths": [
        "crs-plugin-test",
        ".github/workflows/crs-plugin-integration.yaml"
      ]
    },
    "install-go-ftw": {
      "component": "install-go-ftw",
      "paths": [
        "install-go-ftw"
      ]
    }
  },
  "release-type": "simple"
}
